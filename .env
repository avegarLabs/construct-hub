#===== PostgreSQL Local (requerido por el compose) =====
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_URL=jdbc:postgresql://localhost:5432/construct-hub
DB_PORT=5432

# ===== Supabase (si usas BD externa) =====
SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=construct-hub
SUPABASE_DB_USER=admin
SUPABASE_DB_PASSWORD=admin

# ===== Hibernate =====
HIBERNATE_DDL=update
HIBERNATE_SHOW_SQL=true

# ===== App =====
SERVER_PORT=8080